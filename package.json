{
  "name": "the-quiet",
  "private": true,
  "version": "0.2.0",
  "description": "THE QUIET — a systemic hospital horror prototype. The Entity is a system, fear is an input, there is no safe zone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "soak": "vitest run tests/soak.test.ts",
    "campaign": "CAMPAIGN=1 vitest run --silent=false --reporter=verbose",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "~6.4.4",
    "vitest": "~4.1.11"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
